{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "Explanatory",
  "env": {
    "GITHUB_TOKEN": "set-this-in-your-shell-not-here",
    "SENTRY_AUTH_TOKEN": "set-this-in-your-shell-not-here",
    "LINEAR_API_KEY": "set-this-in-your-shell-not-here",
    "DATABASE_URL": "set-this-in-your-shell-not-here"
  },
  "permissions": {
    "allow": [
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
